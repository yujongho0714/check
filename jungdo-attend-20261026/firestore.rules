rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 도장 계정(아래 이메일)으로 로그인한 기기만 읽기/쓰기 가능
    // ★ 아래 이메일은 이 앱의 도장 계정이에요 (Firebase Authentication 에 만든 계정과 같아야 해요)
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "schp2118@gmail.com";
    }
  }
}
